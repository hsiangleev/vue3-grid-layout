{
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.fixAll.tslint": "explicit",
        "source.fixAll.stylelint": "explicit"
    },
    "editor.tabSize": 4,
    "css.validate": false,
    "scss.lint.unknownAtRules": "ignore",
    "files.associations": {
        "*.css": "css"
    },
    "less.validate": false,
    "scss.validate": false,
    "stylelint.validate": [
        "vue",
        "css",
        "scss",
        "postcss"
    ]
}