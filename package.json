{
  "name": "vue3-grid-nested",
  "private": false,
  "version": "0.0.5",
  "type": "module",
  "license": "MIT",
  "typings": "./dist/vue3-grid-nested.es.d.ts",
  "files": [
    "dist"
  ],
  "main": "./dist/vue3-grid-nested.umd.js",
  "module": "./dist/vue3-grid-nested.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue3-grid-nested.es.js",
      "require": "./dist/vue3-grid-nested.umd.js"
    },
    "./style.css": "./dist/vue3-grid-nested.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hsiangleev/vue3-grid-nested"
  },
  "author": "hsianglee",
  "homepage": "https://vue3-grid-nested.hsianglee.cn",
  "description": "vue3栅栏嵌套布局",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build --emptyOutDir",
    "build:lib": "vue-tsc -b && vite build --emptyOutDir --mode lib",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "styleLint": "stylelint **/*.{css,vue} --fix"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "element-plus": "^2.11.5",
    "eslint": "9.32.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "stylelint": "^16.25.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.1.0"
  }
}
